# Copy this file to .env and fill in the key(s) for the model(s) you want to use.
# MedPhi uses LiteLLM, so any supported provider works.

# OpenAI (for gpt-4o-mini, gpt-4o)
OPENAI_API_KEY=sk-...

# Anthropic (for claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...

# For local models (ollama/mistral etc.) no key needed — just have Ollama running.
